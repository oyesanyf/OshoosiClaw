{
  "manifest_version": 3,
  "name": "OshoosiClaw Browser DLP Sensor",
  "short_name": "OshoosiClaw DLP",
  "version": "1.2.0",
  "description": "Checks outgoing form and API submissions for sensitive data and reports them only to the OshoosiClaw agent running on this computer.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["webRequest", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "OshoosiClaw Browser DLP Sensor"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-dlp-sensor@oshoosiclaw.local",
      "strict_min_version": "121.0"
    }
  }
}
