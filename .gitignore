# ============================================
# OshoosiClaw — .gitignore
# ============================================

# ---------- Rust / Cargo ----------
/target/
/target_*/
/target_alt/
/target_ci_check/
/target_test_wire/
**/*.rs.bk
*.pdb

# Cargo.lock MUST be committed for binary crates (reproducible builds)
# Do NOT ignore Cargo.lock

# ---------- Build Artifacts ----------
*.o
!ebpf/osoosi_probe.bpf.o
!ebpf/bin/osoosi-ebpf.o
!driver/windows/*.sys
*.obj
*.rlib
*.rmeta
*.d
*.dylib
*.so
*.wixpdb
*.exe
*.dll
*.msi
*.msi.asc
*.msi.sig
*.msi.intoto.jsonl
*.intoto.jsonl
*.sfx
*.wasm
*.pt
*.safetensors
/bin/
/tests/poison_tests/
*.locked.*

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Databases (runtime) ----------
*.db
*.db.bak
*.db-shm
*.db-wal
*.db-journal
odidere.db*
osoosi.db*
