# ============================================
# OshoosiClaw — .gitignore
# ============================================

# ---------- Rust / Cargo ----------
/target/
/target_alt/
/target_ci_check/
**/*.rs.bk
*.pdb

# Cargo.lock MUST be committed for binary crates (reproducible builds)
# Do NOT ignore Cargo.lock

# ---------- Build Artifacts ----------
*.o
*.obj
*.rlib
*.rmeta
*.d
*.dylib
*.so

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Databases (runtime) ----------
*.db
*.db-shm
*.db-wal
*.db-journal
odidere.db*
osoosi.db*

# ---------- Logs ----------
logs/
*.log

# ---------- Secrets & Certificates ----------
certs/
*.pem
*.key
*.crt
*.p12
*.pfx
osoosi.toml.sig
osoosi.toml.sign

# ---------- Provisioned Tools (auto-downloaded at runtime) ----------
/Sysmon.exe
/Sysmon64.exe
/Sysmon64a.exe
/sysmonconfig-export.xml
/Eula.txt

# ---------- Runtime Data ----------
/data/
/models/
/yara/
/quarantine/
/traps/
/malware/
/cache/

# ---------- Build Check Artifacts ----------
build_check_*.txt
build_error*.txt
build_errors*.txt
build_output*.txt
check_*.txt
core_err.txt
behavioral_err.txt
errors.txt
output.txt
test_output.txt
test_peer_build.txt
release_build_output.txt
package_output_bat.txt
error.log
error_core.log

# ---------- Deployment Packages ----------
*.zip
/osoosi_deploy/

# ---------- Temp / Misc ----------
/tmp/
.cargo/
.crates.toml
.crates2.json
/scratch/

# ---------- Python (LLM Agent) ----------
agent/__pycache__/
agent/.venv/
agent/*.pyc
*.egg-info/

# ---------- Node (Dashboard) ----------
node_modules/
dashboard/node_modules/

# ---------- System / Gemini ----------
.gemini/
.antigravity/
error.txt
matches.txt
dataset/
crates/osoosi-model/models/
